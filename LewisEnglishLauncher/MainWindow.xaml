<Window x:Class="LewisEnglishLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lewis, English Speaking Coach - Actualizador"
        Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0E2233"
        Icon="/Assets/appicon.ico">

    <Window.Resources>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Background" Value="#00A9A5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A4A60" />
                    <Setter Property="Foreground" Value="#7A93A6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#16A34A" />
        </Style>
        <Style x:Key="BotonNaranja" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#F5A623" />
        </Style>
        <Style x:Key="BotonGris" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#2A4A60" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image Grid.Row="0" Source="/Assets/lewis_logo.png" Height="76"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Estado / versiones -->
        <Border Grid.Row="1" Background="#1A3A52" CornerRadius="12" Padding="20" Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="Actualizador de la aplicacion"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="VERSION INSTALADA" Foreground="#8FB0C4" FontSize="11"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtVersionLocal" Text="-" Foreground="#00D6D1"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="ULTIMA VERSION" Foreground="#8FB0C4" FontSize="11"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtVersionRemota" Text="-" Foreground="#F5A623"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mensaje de estado / notas -->
        <Border Grid.Row="2" Background="#1A3A52" CornerRadius="12" Padding="18" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtEstado" Text="Buscando actualizaciones..."
                           Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ProgressBar x:Name="Barra" Height="6" Margin="0,12,0,0"
                             IsIndeterminate="False" Visibility="Collapsed"
                             Background="#0E2233" Foreground="#00A9A5" BorderThickness="0" />
                <TextBlock x:Name="TxtNotas" Text="" Foreground="#8FB0C4" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBuscar" Grid.Column="0" Content="Buscar de nuevo"
                    Style="{StaticResource BotonGris}"
                    Click="BtnBuscar_Click" />

            <Button x:Name="BtnActualizar" Grid.Column="2" Content="Actualizar ahora"
                    Style="{StaticResource BotonNaranja}" Margin="0,0,10,0"
                    IsEnabled="False" Click="BtnActualizar_Click" />

            <Button x:Name="BtnAbrir" Grid.Column="3" Content="Abrir aplicacion"
                    Style="{StaticResource BotonExito}"
                    Click="BtnAbrir_Click" />
        </Grid>
    </Grid>
</Window>
