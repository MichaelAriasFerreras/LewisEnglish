<UserControl x:Class="LewisEnglish.Views.EstudiantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Estudiantes" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="Perfiles, horarios, tarifas y forma de pago"
                           Style="{StaticResource SubtituloPagina}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" Margin="0,0,8,0" />
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}" Margin="0,0,8,0" />
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}" />
            </StackPanel>
        </Grid>

        <!-- Formulario -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,14,0,0"
                Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoPrincipal}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Nombre completo" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Nombre, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Cedula" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Cedula, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Email" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Telefono" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Telefono, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="WhatsApp" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.WhatsApp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Direccion" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Direccion, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Dia de clase" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding DiasSemana}" SelectedItem="{Binding Editable.DiaClase}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Hora de inicio (clase de 2 horas)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Franjas}" SelectedItem="{Binding Editable.HoraInicio}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Frecuencia de pago" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Frecuencias}" SelectedItem="{Binding Editable.Frecuencia}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Tarifa (RD$)" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Tarifa, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Forma de pago" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding Editable.FormaPago}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,0">
                        <TextBlock Text="Banco (si es transferencia)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Bancos}" SelectedItem="{Binding Editable.Banco}" IsEditable="True" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Editable.Estado}" Width="160" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Guardar" Style="{StaticResource BotonExito}"
                            Command="{Binding GuardarCommand}" Margin="0,0,8,0" />
                    <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding CancelarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
            <DataGrid ItemsSource="{Binding Estudiantes}" SelectedItem="{Binding Seleccionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Cedula" Binding="{Binding Cedula}" Width="Auto" />
                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="Auto" />
                    <DataGridTextColumn Header="Dia" Binding="{Binding DiaClaseTexto}" Width="Auto" />
                    <DataGridTextColumn Header="Horario" Binding="{Binding RangoHorario}" Width="Auto" />
                    <DataGridTextColumn Header="Frecuencia" Binding="{Binding FrecuenciaTexto}" Width="Auto" />
                    <DataGridTextColumn Header="Tarifa" Binding="{Binding Tarifa, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                    <DataGridTemplateColumn Header="Estado" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Estado, Converter={StaticResource EstadoEstudianteColorConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="WhatsApp" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Mensaje" Style="{StaticResource BotonExito}"
                                        Padding="10,4" FontSize="12"
                                        Command="{Binding DataContext.WhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
