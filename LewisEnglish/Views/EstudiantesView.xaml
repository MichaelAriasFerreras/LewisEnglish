<UserControl x:Class="LewisEnglish.Views.EstudiantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Estudiantes" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="Perfiles, horarios, tarifas y forma de pago"
                           Style="{StaticResource SubtituloPagina}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding TextoFiltroMorosos}" Style="{StaticResource BotonSecundario}"
                        Command="{Binding FiltrarMorososCommand}" Margin="0,0,8,0" />
                <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" Margin="0,0,8,0" />
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}" Margin="0,0,8,0" />
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}" />
            </StackPanel>
        </Grid>

        <!-- Formulario -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,14,0,0"
                Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoPrincipal}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Nombre completo" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Nombre, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Telefono" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Telefono, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="WhatsApp" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.WhatsApp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Email" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Direccion" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Direccion, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Dia de clase" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding DiasSemana}" SelectedItem="{Binding Editable.DiaClase}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Hora de inicio" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Franjas}" SelectedItem="{Binding Editable.HoraInicio}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Duracion (horas)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Duraciones}" SelectedItem="{Binding Editable.DuracionHoras}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Frecuencia de pago" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Frecuencias}" SelectedItem="{Binding Editable.Frecuencia}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Tarifa (RD$)" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Text="{Binding Editable.Tarifa, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Forma de pago" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding Editable.FormaPago}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,0">
                        <TextBlock Text="Banco (si es transferencia)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding Bancos}" SelectedItem="{Binding Editable.Banco}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editable.FormaPago}" Value="Transferencia">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,8,10,0">
                        <TextBlock Text="Dia de pago (del mes)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox ItemsSource="{Binding DiasPago}" SelectedItem="{Binding Editable.DiaPago}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Guardar" Style="{StaticResource BotonExito}"
                            Command="{Binding GuardarCommand}" Margin="0,0,8,0" />
                    <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding CancelarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabla + Panel de detalle -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Tabla de estudiantes -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <DataGrid ItemsSource="{Binding Estudiantes}" SelectedItem="{Binding Seleccionado}"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="Auto" />
                        <DataGridTextColumn Header="Dia" Binding="{Binding DiaClaseTexto}" Width="Auto" />
                        <DataGridTextColumn Header="Horario" Binding="{Binding RangoHorario}" Width="Auto" />
                        <DataGridTextColumn Header="Frecuencia" Binding="{Binding FrecuenciaTexto}" Width="Auto" />
                        <DataGridTextColumn Header="Tarifa" Binding="{Binding Tarifa, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                        <DataGridTemplateColumn Header="Estado" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Estado, Converter={StaticResource EstadoEstudianteColorConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mora" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MoraTexto}" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Rojo}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="WhatsApp" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Mensaje" Style="{StaticResource BotonExito}"
                                            Padding="10,4" FontSize="12"
                                            Command="{Binding DataContext.WhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Panel de detalle del estudiante seleccionado -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Width="420" Margin="14,0,0,0"
                    Background="{StaticResource FondoPanel}"
                    Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Nombre prominente -->
                        <TextBlock Text="{Binding Seleccionado.Nombre}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextoPrincipal}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Seleccionado.EstadoTexto}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding Seleccionado.Estado, Converter={StaticResource EstadoEstudianteColorConverter}}"
                                   Margin="0,2,0,0" />

                        <!-- Aviso de pagos vencidos -->
                        <Border Background="{StaticResource Naranja}" CornerRadius="8" Padding="10,6" Margin="0,12,0,0"
                                Visibility="{Binding TienePagosVencidos, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Tiene pagos vencidos" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                        </Border>

                        <Button Content="Enviar recordatorio por WhatsApp" Style="{StaticResource BotonExito}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                Command="{Binding WhatsAppCommand}"
                                CommandParameter="{Binding Seleccionado}" />

                        <!-- Informacion de contacto y plan -->
                        <TextBlock Text="Informacion" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Turquesa}" Margin="0,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Telefono:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Seleccionado.Telefono}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="WhatsApp:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Seleccionado.WhatsApp}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Seleccionado.Email}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dia:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Seleccionado.DiaClaseTexto}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Horario:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Seleccionado.RangoHorario}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Frecuencia:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Seleccionado.FrecuenciaTexto}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tarifa:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Seleccionado.Tarifa, Converter={StaticResource CurrencyConverter}}" Foreground="{StaticResource TextoPrincipal}" FontWeight="SemiBold" Margin="0,3" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pago:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Seleccionado.FormaPagoTexto}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Dia de pago:" Foreground="{StaticResource TextoSecundario}" Margin="0,3,10,3" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Seleccionado.DiaPagoTexto}" Foreground="{StaticResource TextoPrincipal}" Margin="0,3" />
                        </Grid>

                        <!-- Resumen financiero -->
                        <TextBlock Text="Resumen de cuenta" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Turquesa}" Margin="0,18,0,6" />
                        <Border Background="{StaticResource FondoPrincipal}" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Facturado" Foreground="{StaticResource TextoSecundario}" FontSize="11" />
                                    <TextBlock Text="{Binding ResumenFacturadoTexto}" Foreground="{StaticResource TextoPrincipal}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pagado" Foreground="{StaticResource TextoSecundario}" FontSize="11" />
                                    <TextBlock Text="{Binding ResumenPagadoTexto}" Foreground="{StaticResource Verde}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pendiente" Foreground="{StaticResource TextoSecundario}" FontSize="11" />
                                    <TextBlock Text="{Binding ResumenPendienteTexto}" Foreground="{StaticResource Naranja}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Historial de pagos -->
                        <TextBlock Text="Historial de pagos" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Turquesa}" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding PagosSeleccionado}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource FondoPrincipal}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Etiqueta}" Foreground="{StaticResource TextoPrincipal}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TotalTexto}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding AbonadoSaldoTexto}" Foreground="{StaticResource TextoSecundario}" FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PagoDetalleTexto}" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FechaVencimientoTexto, StringFormat='Vence: {0}'}" FontSize="11" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Converter={StaticResource VencimientoColorConverter}}" />
                                                    <Button Content="Editar" FontSize="10" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.EditarVencimientoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="  ·  Adelantado" Foreground="{StaticResource Turquesa}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PagoAdelantado}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Nota}" Foreground="{StaticResource TextoSecundario}" FontSize="11" FontStyle="Italic" Margin="0,1,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Nota}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding EstadoTexto}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Top" Margin="6,0,0,0"
                                                       Foreground="{Binding Estado, Converter={StaticResource EstadoPagoColorConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Registro de abonos (movimientos de pago) -->
                        <TextBlock Text="Registro de abonos (movimientos)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Turquesa}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding AbonosSeleccionado}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource FondoPrincipal}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PeriodoEtiqueta}" Foreground="{StaticResource TextoPrincipal}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MontoSaldoTexto}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FechaFormaTexto}" Foreground="{StaticResource TextoSecundario}" FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Historial de asistencia -->
                        <TextBlock Text="Historial de asistencia" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Turquesa}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding AsistenciasSeleccionado}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource FondoPrincipal}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource DateConverter}}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" />
                                                <TextBlock Text="{Binding Nota}" Foreground="{StaticResource TextoSecundario}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding EstadoTexto}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Estado, Converter={StaticResource EstadoAsistenciaColorConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
