<UserControl x:Class="LewisEnglish.Views.PagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Pagos" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="Cobros por periodo, registro de pagos y recordatorios"
                           Style="{StaticResource SubtituloPagina}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Filtrar" Style="{StaticResource EtiquetaCampo}" />
                    <ComboBox Width="160" ItemsSource="{Binding FiltrosEstado}"
                              SelectedItem="{Binding FiltroEstado}" />
                </StackPanel>
                <Button Content="Enviar recordatorios" Style="{StaticResource BotonExito}"
                        VerticalAlignment="Bottom"
                        Command="{Binding RecordatoriosMasivosCommand}" />
            </StackPanel>
        </Grid>

        <!-- Panel de registro de pago -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Registrar o corregir pago del periodo seleccionado" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoPrincipal}" Margin="0,0,0,6" />

                <!-- Periodo seleccionado + resumen de total, abonado y saldo -->
                <Border Background="{StaticResource Navy}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                        BorderBrush="{StaticResource AzulClaro}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pago de: " FontSize="13.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextoSecundario}" />
                            <TextBlock Text="{Binding PeriodoSeleccionadoTexto}" FontSize="14.5" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AzulClaro}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResumenPagoTexto}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoPrincipal}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Registrar un pago o abono (parcial) -->
                <TextBlock Text="Registrar un pago o abono" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AzulClaro}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Monto que paga ahora (RD$)" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Width="150" Text="{Binding MontoAbono, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Forma de pago" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox Width="160" ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPago}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Banco (si es transferencia)" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox Width="180" ItemsSource="{Binding Bancos}" SelectedItem="{Binding Banco}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormaPago}" Value="Transferencia">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Fecha de pago" Style="{StaticResource EtiquetaCampo}" />
                        <DatePicker Width="150" SelectedDate="{Binding FechaPago}" />
                    </StackPanel>
                    <Button Content="Registrar abono / pago" Style="{StaticResource BotonPrimario}"
                            VerticalAlignment="Bottom" Command="{Binding RegistrarPagoCommand}" />
                </StackPanel>
                <TextBlock Text="Ejemplo: si debe RD$ 2,000 y solo paga RD$ 500, escribe 500 aqui. El periodo quedara &quot;Parcial&quot; con un saldo de RD$ 1,500. Cuando termine de pagar el saldo, quedara &quot;Pagado&quot; y se generara la factura."
                           Foreground="{StaticResource TextoSecundario}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- Separador -->
                <Border Height="1" Background="{StaticResource BordeSuave}" Margin="0,14,0,12" />

                <!-- Corregir montos ingresados por error -->
                <TextBlock Text="Corregir montos (si se ingreso algo por error)" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AzulClaro}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Total del periodo (RD$)" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Width="150" Text="{Binding MontoEditable, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Total abonado (RD$)" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox Width="150" Text="{Binding MontoPagadoEditable, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="Guardar cambios" Style="{StaticResource BotonExito}"
                            VerticalAlignment="Bottom" Command="{Binding GuardarCambiosCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Verde}"
                           FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
            <DataGrid ItemsSource="{Binding Pagos}" SelectedItem="{Binding Seleccionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Estudiante" Binding="{Binding EstudianteNombre}" Width="*" />
                    <DataGridTextColumn Header="Periodo" Binding="{Binding Etiqueta}" Width="Auto" />
                    <DataGridTextColumn Header="Frecuencia" Binding="{Binding FrecuenciaTexto}" Width="Auto" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Monto, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                    <DataGridTextColumn Header="Abonado" Binding="{Binding MontoPagado, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                    <DataGridTemplateColumn Header="Estado" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Estado, Converter={StaticResource EstadoPagoColorConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Fecha de pago" Binding="{Binding FechaPago, Converter={StaticResource DateConverter}}" Width="Auto" />
                    <DataGridTemplateColumn Header="Recordatorio" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="WhatsApp" Style="{StaticResource BotonExito}"
                                        Padding="10,4" FontSize="12"
                                        Command="{Binding DataContext.RecordatorioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
