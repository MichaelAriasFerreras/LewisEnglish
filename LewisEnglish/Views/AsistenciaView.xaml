<UserControl x:Class="LewisEnglish.Views.AsistenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Asistencia" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Registro de asistencia a las clases"
                       Style="{StaticResource SubtituloPagina}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de registro -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,12,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Registrar asistencia" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoPrincipal}" Margin="0,0,0,10" />

                    <TextBlock Text="Estudiante" Style="{StaticResource EtiquetaCampo}" />
                    <ComboBox ItemsSource="{Binding Estudiantes}" DisplayMemberPath="Nombre"
                              SelectedItem="{Binding EstudianteSeleccionado}" />

                    <TextBlock Text="Fecha" Style="{StaticResource EtiquetaCampo}" />
                    <DatePicker SelectedDate="{Binding Fecha}" />

                    <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}" />
                    <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" />

                    <TextBlock Text="Nota (opcional)" Style="{StaticResource EtiquetaCampo}" />
                    <TextBox Text="{Binding Nota, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                             VerticalContentAlignment="Top" />

                    <Button Content="Registrar" Style="{StaticResource BotonPrimario}"
                            Command="{Binding RegistrarCommand}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Verde}"
                               FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Historial -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Historial de asistencia" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipal}"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Historial}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estudiante" Binding="{Binding EstudianteNombre}" Width="*" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, Converter={StaticResource DateConverter}}" Width="Auto" />
                            <DataGridTemplateColumn Header="Estado" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Estado, Converter={StaticResource EstadoAsistenciaColorConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
