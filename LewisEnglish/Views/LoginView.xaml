<Window x:Class="LewisEnglish.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lewis, English Speaking Coach - Iniciar Sesion"
        Height="670" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/appicon.ico"
        Background="Transparent">

    <Border Background="{StaticResource FondoPrincipal}" CornerRadius="18" MouseDown="Border_MouseDown">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="X" Width="34" Height="34"
                    HorizontalAlignment="Right" Margin="0,10,10,0"
                    Foreground="{StaticResource TextoSecundario}" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Click="Cerrar_Click" FontWeight="Bold" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="44,0">

                <Image Source="pack://application:,,,/Assets/lewis_logo.png" Height="90" HorizontalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Text="English Speaking Coach" FontSize="15"
                           Foreground="{StaticResource Turquesa}" HorizontalAlignment="Center"
                           Margin="0,14,0,2" FontWeight="SemiBold" />
                <TextBlock Text="Sistema de gestion y facturacion" FontSize="12"
                           Foreground="{StaticResource TextoSecundario}" HorizontalAlignment="Center"
                           Margin="0,0,0,26" />

                <TextBlock Text="Correo electronico" Style="{StaticResource EtiquetaCampo}" />
                <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Contrasena" Style="{StaticResource EtiquetaCampo}" />
                <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />

                <CheckBox Content="Recordar correo"
                          IsChecked="{Binding RecordarCorreo, Mode=TwoWay}"
                          Foreground="{StaticResource TextoSecundario}"
                          FontSize="12" Margin="2,14,0,0" VerticalContentAlignment="Center" />

                <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource Rojo}"
                           FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" />

                <Button Content="Ingresar" Style="{StaticResource BotonPrimario}"
                        Height="44" Margin="0,20,0,0" Click="Ingresar_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
