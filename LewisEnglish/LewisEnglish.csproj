<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <RootNamespace>LewisEnglish</RootNamespace>
    <AssemblyName>LewisEnglish</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <Product>Lewis - Sistema de Facturacion</Product>
    <AssemblyTitle>Lewis, English Speaking Coach</AssemblyTitle>
    <Company>Lewis English Speaking Coach</Company>
    <Version>1.8.0</Version>
    <FileVersion>1.8.0.0</FileVersion>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="7.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="7.0.20" />
    <PackageReference Include="QuestPDF" Version="2023.12.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\appicon.ico" />
    <Resource Include="Assets\lewis_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia del logo junto al ejecutable para que QuestPDF lo cargue en tiempo de ejecucion -->
    <None Include="Assets\lewis_logo.png" Link="lewis_logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
